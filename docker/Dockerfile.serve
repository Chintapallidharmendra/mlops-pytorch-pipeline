# ---- Stage 1: base -------------------------------------------------------
FROM python:3.11-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# libgomp1 provides libgomp.so.1, required by the PyTorch Linux pip wheel at
# import time (same fix as docker/Dockerfile.train; python:*-slim omits it).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt

# ---- Stage 2: serving runtime ---------------------------------------------
FROM base AS serving

COPY src/ ./src/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

# serve.py's default checkpoint path ("checkpoints/classifier_v1.pt") is
# resolved against the CWD (WORKDIR /app), matching the /app/checkpoints
# volume mount used at runtime — do not cd into src/ for this reason.
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --no-create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/checkpoints \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health', timeout=2)"

# serve.py has no __main__ launcher, so uvicorn is invoked directly against
# the `app` object. PYTHONPATH=/app/src (set above) makes `serve` (and its
# sibling imports `dataset`/`model`) resolve as top-level modules.
ENTRYPOINT ["python", "-m", "uvicorn", "serve:app", "--host", "0.0.0.0", "--port", "8080"]
